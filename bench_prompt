            {
              "source_text_id": "text_4",
              "content": "III. Field Notes",
              "role": "标题",
              "reference_position_legacy": "右侧中部",
              "reference_typography_legacy": "白色，中等字号，粗体，左对齐"
            },
            {
              "source_text_id": "text_16",
              "content": "01 Physical Layer (L1): The foundation of all transit. It encompasses the raw transmission of bits over physical media including copper wires, fiber optics, or radio waves.",
              "role": "正文",
              "reference_position_legacy": "右侧“Field Notes”下方",
              "reference_typography_legacy": "黑色，小字号，常规，两端对齐"
            },
            {
              "source_text_id": "text_17",
              "content": "02 Network Layer (L3): Responsible for packet forwarding and routing. It utilizes logical IP addresses to find paths across multiple network nodes.",
              "role": "正文",
              "reference_position_legacy": "右侧“Field Notes”下方",
              "reference_typography_legacy": "黑色，小字号"
            },
            {
              "source_text_id": "text_18",
              "content": "03 Transport Layer (L4): Manages end-to-end communication. TCP provides reliable delivery via handshakes, whereas UDP prioritizes speed over integrity.",
              "role": "正文",
              "reference_position_legacy": "右侧“Field Notes”下方",
              "reference_typography_legacy": "黑色，小字号"
            },
            {
              "source_text_id": "text_19",
              "content": "04 Application (L7): The interface for users. HTTP for web browsing, SMTP for mail, and SSH for secure remote management operate here.",
              "role": "正文",
              "reference_position_legacy": "右侧“Field Notes”下方",
              "reference_typography_legacy": "黑色，小字号"
            }
          ],
          "formatted_content": "III. Field Notes\n01 Physical Layer (L1): The foundation of all transit. It encompasses the raw transmission of bits over physical media including copper wires, fiber optics, or radio waves.\n02 Network Layer (L3): Responsible for packet forwarding and routing. It utilizes logical IP addresses to find paths across multiple network nodes.\n03 Transport Layer (L4): Manages end-to-end communication. TCP provides reliable delivery via handshakes, whereas UDP prioritizes speed over integrity.\n04 Application (L7): The interface for users. HTTP for web browsing, SMTP for mail, and SSH for secure remote management operate here.",
          "mapping_status": "two_pass_model_visual_audit_not_human",
          "geometry_status": "regrouped_reference_boxes_not_rebuilt"
